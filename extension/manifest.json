{
  "manifest_version": 3,
  "name": "Poliplast CRM — Memoria WhatsApp",
  "version": "0.15.0",
  "description": "Mantiene la memoria comercial de WhatsApp sincronizada con Poliplast Sales Copilot.",
  "permissions": ["storage"],
  "host_permissions": ["https://web.whatsapp.com/*", "https://poli-crm.vercel.app/*"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://poli-crm.vercel.app/*"],
      "js": ["pairing.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": {
    "default_title": "Memoria comercial Poliplast",
    "default_popup": "popup.html"
  }
}
