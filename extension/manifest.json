{
  "manifest_version": 3,
  "name": "Poliplast CRM — Memoria WhatsApp",
  "version": "0.1.0",
  "description": "Sincroniza únicamente las conversaciones autorizadas con Poliplast Sales Copilot.",
  "permissions": ["storage"],
  "host_permissions": ["https://web.whatsapp.com/*", "https://poli-crm.vercel.app/*"],
  "content_scripts": [{
    "matches": ["https://web.whatsapp.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "options_page": "options.html",
  "action": { "default_title": "Configurar memoria Poliplast" }
}
