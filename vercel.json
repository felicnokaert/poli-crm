    { "path": "/api/admin-users?cron=contabilium-stock-3", "schedule": "25 19 * * *" },
    { "path": "/api/admin-users?cron=shopify", "schedule": "30 10 * * *" },
    { "path": "/api/admin-users?cron=alertas", "schedule": "45 11 * * *" },
    { "path": "/api/admin-users?cron=trello-plan", "schedule": "55 11 * * 1-6" },
    { "path": "/api/admin-users?cron=gmail-envios&run=1", "schedule": "40 12 * * 1-5" },
    { "path": "/api/admin-users?cron=gmail-envios&run=2", "schedule": "10 14 * * 1-5" },
    { "path": "/api/admin-users?cron=gmail-envios&run=3", "schedule": "40 15 * * 1-5" },
    { "path": "/api/admin-users?cron=gmail-envios&run=4", "schedule": "10 17 * * 1-5" },
    { "path": "/api/admin-users?cron=gmail-envios&run=5", "schedule": "40 18 * * 1-5" },
    { "path": "/api/admin-users?cron=gmail-envios&run=6", "schedule": "10 20 * * 1-5" },
    { "path": "/api/admin-users?cron=examen-1", "schedule": "5 12 * * 1" },
    { "path": "/api/admin-users?cron=examen-2", "schedule": "45 12 * * 1" },
    { "path": "/api/admin-users?cron=entrenamiento-1", "schedule": "10 12 * * *" },
    { "path": "/api/admin-users?cron=entrenamiento-2", "schedule": "40 13 * * *" },
    { "path": "/api/admin-users?cron=entrenamiento-3", "schedule": "10 15 * * *" },
    { "path": "/api/admin-users?cron=entrenamiento-4", "schedule": "40 16 * * *" },
    { "path": "/api/admin-users?cron=entrenamiento-5", "schedule": "10 18 * * *" },
    { "path": "/api/admin-users?cron=entrenamiento-6", "schedule": "40 19 * * *" },
    { "path": "/api/admin-users?cron=entrenamiento-7", "schedule": "10 21 * * *" },
    { "path": "/api/admin-users?cron=entrenamiento-8", "schedule": "40 22 * * *" },
    { "path": "/api/admin-users?cron=entrenamiento-9", "schedule": "10 0 * * *" },
    { "path": "/api/admin-users?cron=entrenamiento-10", "schedule": "40 1 * * *" },
    { "path": "/api/admin-users?cron=entrenamiento-11", "schedule": "10 3 * * *" },
    { "path": "/api/admin-users?cron=entrenamiento-12", "schedule": "40 4 * * *" },
    { "path": "/api/admin-users?cron=entrenamiento-13", "schedule": "10 6 * * *" },
    { "path": "/api/admin-users?cron=entrenamiento-14", "schedule": "40 7 * * *" },
    { "path": "/api/admin-users?cron=entrenamiento-15", "schedule": "20 9 * * *" },
    { "path": "/api/admin-users?cron=entrenamiento-16", "schedule": "50 10 * * *" },
    { "path": "/api/admin-users?cron=mercadolibre-clips-1", "schedule": "5 3 * * *" },
    { "path": "/api/admin-users?cron=mercadolibre-clips-2", "schedule": "35 3 * * *" },
    { "path": "/api/admin-users?cron=mercadolibre-clips-3", "schedule": "5 4 * * *" },
    { "path": "/api/admin-users?cron=mercadolibre-clips-4", "schedule": "35 4 * * *" },
    { "path": "/api/admin-users?cron=mercadolibre-clips-5", "schedule": "5 5 * * *" },
    { "path": "/api/admin-users?cron=mercadolibre-clips-6", "schedule": "35 5 * * *" },
    { "path": "/api/admin-users?cron=mercadolibre-clips-7", "schedule": "5 6 * * *" },
    { "path": "/api/admin-users?cron=mercadolibre-clips-8", "schedule": "35 6 * * *" },
    { "path": "/api/admin-users?cron=mercadolibre-clips-9", "schedule": "5 7 * * *" },
    { "path": "/api/admin-users?cron=mercadolibre-clips-10", "schedule": "35 7 * * *" }
  ],
  "functions": {
    "api/prospeccion.js": { "maxDuration": 60 },
    "api/admin-users.js": { "maxDuration": 60 },
    "api/whatsapp-webhook.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/readiness", "destination": "/api/health" },
    { "source": "/api/entregas/:route", "destination": "/api/admin-users?entregas=:route" },
    { "source": "/api/etiquetas/:route", "destination": "/api/admin-users?etiquetas=:route" },
    { "source": "/api/dolar", "destination": "/api/admin-users?dolar=1" },
    { "source": "/api/feriados/:year", "destination": "/api/admin-users?feriados=:year" },
    { "source": "/api/gmail-callback", "destination": "/api/admin-users?gmail=callback" },
    { "source": "/api/shopify-webhook", "destination": "/api/whatsapp-webhook?shopify=1" }
  ],
  "headers": [
    {
      "source": "/mapa(/.*)?",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(self \"https://poli-entregas.vercel.app\"), microphone=(), geolocation=()" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; form-action 'none'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/mapa/(data|vendor|fonts)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/((?!mapa|entregas-maqueta|entregas-app|conteo-maqueta|conteo-app).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self \"https://poli-entregas.vercel.app\"), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://graph.facebook.com https://www.facebook.com https://api.mercadolibre.com https://apis.datos.gob.ar https://api.open-meteo.com https://geocoding-api.open-meteo.com; frame-src 'self' https://cotizador-poliplast.vercel.app https://poliplast-cotizador.vercel.app https://poli-entregas.vercel.app https://www.facebook.com https://web.facebook.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/(entregas-maqueta|entregas-app|conteo-maqueta|conteo-app)(/.*)?",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://graph.facebook.com https://www.facebook.com https://api.mercadolibre.com https://apis.datos.gob.ar https://api.open-meteo.com https://geocoding-api.open-meteo.com; frame-src 'self' https://cotizador-poliplast.vercel.app https://poliplast-cotizador.vercel.app https://poli-entregas.vercel.app https://www.facebook.com https://web.facebook.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
